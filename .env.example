# PostgreSQL: set either DATABASE_URL or the PG* values below.
# Example: postgresql://postgres:replace_me@127.0.0.1:5432/tbls_iot
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=tbls_iot
PGUSER=postgres
PGPASSWORD=replace_me
PGSSL=false
PG_POOL_MAX=10

# Existing AirClip auth configuration (use strong, unique random secrets).
PORT=4000
COOKIE_SECRET=replace_me
JWT_SECRET=replace_me
CRYPTO_SECRET=replace_me
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_FOR_DEVELOPMENT=http://localhost:3000
EXPRESS_SESSION_SECRET=replace_me

# SMTP credentials must never be committed to source control.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set to "simulator" while the Pico is unavailable.
# Set to "mqtt" only when MQTT credentials and the broker CA are configured.
IOT_MODE=simulator
MQTT_URL=mqtts://43.204.87.61:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT_PATH=
